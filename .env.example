# Shared AXXES Neon database (same as members.axxes.club)
DATABASE_URL=
# Must match members.axxes.club so both apps accept the same accounts
BETTER_AUTH_SECRET=
# Public URL of this app
BETTER_AUTH_URL=https://relay.axxes.club
# Central sign-in, so a Relay user signs in through Handshake
HANDSHAKE_URL=https://handshake.axxes.club
# Shared session cookie across every *.axxes.club app
AUTH_COOKIE_DOMAIN=.axxes.club
# Realtime delivery (messages, typing, unread). Pusher is already configured for
# the rest of the suite, so reuse those keys rather than creating a new app.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
